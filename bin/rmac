#
# MacOS/Darwin: WINE/32bit no longer supported by MacOS - use native build
#
platform=`uname`
if [ $platform = "Darwin" ] ; then

$AGTROOT/bin/mac/rmac -i$AGTROOT "$@"

else

#
# Cygwin: use native Windows build
#
platform=`uname -o`
if [ $platform = "Cygwin" ] ; then
$AGTROOT/bin/rmac.exe -i`command -v cygpath >/dev/null && cygpath -C ANSI -w $AGTROOT` "$@"
else

#
# WSL: use native Windows build
#
if grep -iq microsoft /proc/version ; then
$AGTROOT/bin/rmac.exe -i`command -v cygpath >/dev/null && cygpath -C ANSI -w $AGTROOT || wslpath -aw $AGTROOT` "$@"

else

#
# Linux: use WINE + native Windows build
#
wine $AGTROOT/bin/rmac.exe -i$AGTROOT "$@"

#

fi #!WSL
fi #!Cygwin
fi #!Darwin